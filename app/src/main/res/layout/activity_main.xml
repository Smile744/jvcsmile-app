<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D11">

    <!-- Fondo de Pantalla o Contenedor del Joker Medieval -->
    <ImageView
        android:id="@+id/ivJoker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_joker_blue" />

    <!-- Capa Translúcida de Humo/Tinte Neón Místico -->
    <View
        android:id="@+id/overlayGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- HUD SUPERIOR: Widget del Reloj Gótico -->
            <TextView
                android:id="@+id/clockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="21:00"
                android:textColor="#00E5FF"
                android:textSize="54sp"
                android:textStyle="bold" />

            <!-- Frases Dinámicas Basadas en tus Modos -->
            <TextView
                android:id="@+id/phraseText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Modo Normal — Relájate"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- DUALIDAD DEL JOKER: Interruptor de Personalidad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnModeNormal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#005577"
                    android:text="AZUL · NORMAL"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnModeGaming"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="#7A0010"
                    android:text="ROJO · GAMING"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ZÓCALO CENTRAL: Cuadrícula con márgenes y espaciado correcto -->
            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/iconGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                app:columnCount="4"
                app:alignmentMode="alignBounds"
                app:columnOrderPreserved="false">

                <!-- Los elementos de las aplicaciones se inyectan dinámicamente aquí -->
            </androidx.gridlayout.widget.GridLayout>

            <!-- GATILLO: mostrar/ocultar panel avanzado -->
            <Button
                android:id="@+id/btnTogglePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="#252530"
                android:text="AJUSTES DEL REINO"
                android:textColor="#FFFFFF" />

            <!-- PANEL DE CONTROLES: fila de Shizuku se inserta dinámicamente en el índice 0 -->
            <LinearLayout
                android:id="@+id/controlsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ZÓCALO I: Frecuencia de Actualización -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Frecuencia de Actualización (Hz)"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn60hz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="60 Hz" />

                    <Button
                        android:id="@+id/btn90hz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="90 Hz" />

                    <Button
                        android:id="@+id/btn120hz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="120 Hz" />

                    <Button
                        android:id="@+id/btn144hz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="144 Hz" />
                </LinearLayout>

                <!-- ZÓCALO II: Escala de Resolución y DPI -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Escala de Batalla (Resolución y DPI)"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/inputWidth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Ancho"
                        android:inputType="number"
                        android:textColorHint="#88FFFFFF" />

                    <EditText
                        android:id="@+id/inputHeight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Alto"
                        android:inputType="number"
                        android:textColorHint="#88FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
